{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            // Close the running app, rebuild, relaunch. Bound to the default
            // build shortcut because it is the loop you actually want: a plain
            // build fails at link while the app is holding its own exe.
            "label": "dev: build & relaunch",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/tools/dev-run.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dev: build only",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/tools/dev-run.ps1",
                "-NoRun"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/",
                "--target",
                "OpenFunscripter"
            ]
        },
        {
            "label": "buildLocalization",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/",
                "--target",
                "gen_localization"
            ]
        }
    ]
}
